        </mxCell>
        <mxCell id="sline" style="dashed=1;endArrow=none;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1060" y="90" />
            <mxPoint as="targetPoint" x="1060" y="840" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg0" value="1. POST checkout/quote + POST orders (customer JWT)" style="endArrow=block;html=1;fontSize=12;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="100" y="140" />
            <mxPoint as="targetPoint" x="420" y="140" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg1" value="2. Validate stock / persist order + reservation + outbox" style="endArrow=block;html=1;fontSize=12;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="420" y="205" />
            <mxPoint as="targetPoint" x="740" y="205" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="3. Transaction committed" style="endArrow=block;html=1;fontSize=12;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
