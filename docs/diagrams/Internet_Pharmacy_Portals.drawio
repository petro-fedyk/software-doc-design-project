<mxfile host="app.diagrams.net" type="device">
  <diagram id="components-and-architecture" name="Components and architecture">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="customer" value="«component» Customer Portal&lt;br&gt;HTML / CSS / Vanilla JS&lt;br&gt;Catalog · cart · orders · profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="80" width="350" height="110" />
        </mxCell>
        <mxCell id="management" value="«component» Management Portal&lt;br&gt;HTML / CSS / Vanilla JS&lt;br&gt;Staff · inventory · administration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="80" width="350" height="110" />
        </mxCell>
        <mxCell id="api" value="«component» Django REST API&lt;br&gt;JWT · ownership · roles · pharmacy assignment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="300" width="360" height="100" />
        </mxCell>
        <mxCell id="services" value="«component» Application services&lt;br&gt;Domain patterns · repositories · Unit of Work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="470" width="360" height="100" />
        </mxCell>
        <mxCell id="worker" value="«component» Outbox worker&lt;br&gt;Same backend code&lt;br&gt;Simulated payment / delivery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="470" width="300" height="100" />
        </mxCell>
        <mxCell id="mysql" value="«database» MySQL&lt;br&gt;internet_pharmacy&lt;br&gt;Original persistent database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1eb;strokeColor=#3b7058;fontSize=15;shape=cylinder3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="700" width="360" height="100" />
        </mxCell>
        <mxCell id="customerapi" value="same-origin proxy → REST / JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="customer" target="api">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="managementapi" value="same-origin proxy → REST / JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="management" target="api">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="apiservices" value="use cases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="api" target="services">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="servicesmysql" value="ORM / transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="services" target="mysql">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="workermysql" value="outbox / results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="worker" target="mysql">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
