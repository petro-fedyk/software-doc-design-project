        <mxCell id="tbl-orders" value="&lt;div style=&quot;font-family:Arial;font-size:14px&quot;&gt;&lt;b&gt;orders&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:4px 0&quot;/&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[PK] id : BIGINT UNSIGNED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[UQ] order_number : VARCHAR(36) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[FK→users.id/IDX] customer_id : BIGINT UNSIGNED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[FK→pharmacies.id/IDX] pharmacy_id : BIGINT UNSIGNED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[IDX] status : VARCHAR(32) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;fulfillment_method : VARCHAR(16) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;payment_method : VARCHAR(32) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;subtotal : DECIMAL(12,2) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;discount_total : DECIMAL(12,2) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;shipping_total : DECIMAL(12,2) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;grand_total : DECIMAL(12,2) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;currency : CHAR(3) NOT NULL DEFAULT &amp;#x27;UAH&amp;#x27;&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;[IDX] created_at : DATETIME(6) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px&quot;&gt;updated_at : DATETIME(6) NOT NULL&lt;/div&gt;&lt;hr style=&quot;margin:4px 0&quot;/&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;&lt;b&gt;CHECKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_fulfillment: fulfillment_method IN (&amp;#x27;PICKUP&amp;#x27;,&amp;#x27;COURIER&amp;#x27;,&amp;#x27;POSTAL&amp;#x27;)&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_status: status IN (&amp;#x27;PENDING_CONFIRMATION&amp;#x27;,&amp;#x27;CONFIRMED&amp;#x27;,&amp;#x27;PROCESSING&amp;#x27;,&amp;#x27;READY_FOR_PICKUP&amp;#x27;,&amp;#x27;AWAITING_SHIPMENT&amp;#x27;,&amp;#x27;SHIPPED&amp;#x27;,&amp;#x27;COMPLETED&amp;#x27;,&amp;#x27;CANCELLED&amp;#x27;)&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_subtotal: subtotal &amp;gt;= 0&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_discount: discount_total &amp;gt;= 0&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_shipping: shipping_total &amp;gt;= 0&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:10px&quot;&gt;chk_orders_grand_total: grand_total &amp;gt;= 0&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;strokeColor=#52677D;fillColor=#FFFFFF;" vertex="1" parent="1">
