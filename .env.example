# Copy to .env and replace both placeholders with local-only passwords.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
MYSQL_DATABASE=internet_pharmacy
MYSQL_USER=internet_pharmacy
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308

# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=0
# Explicit authorization for simulated prescription verification; empty denies all.
PHARMACIST_IDS=
ENABLED_PAYMENT_METHODS=CARD,BANK_TRANSFER,CASH_ON_DELIVERY,ONLINE_GATEWAY
